{
  "mcpServers": {
    "studio": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/studio_server.py"
      ],
      "env": {
        "TVS_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "TVS_OPT_FAL_KEY": "${user_config.fal_key}",
        "TVS_OPT_ELEVENLABS_API_KEY": "${user_config.elevenlabs_api_key}",
        "TVS_OPT_THREADS_ACCESS_TOKEN": "${user_config.threads_access_token}",
        "TVS_OPT_NARRATOR_VOICE_ID": "${user_config.narrator_voice_id}",
        "TVS_OPT_CTA_URL": "${user_config.cta_url}",
        "TVS_OPT_WORKSPACE": "${user_config.workspace}",
        "TVS_OPT_MEDIA_BUCKET": "${user_config.media_bucket}",
        "TVS_OPT_AWS_PROFILE": "${user_config.aws_profile}",
        "TVS_OPT_AWS_REGION": "${user_config.aws_region}"
      }
    }
  }
}
