<!doctype html>
<html lang="ja" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>{{TITLE}}</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
{{FONT_LINK}}
    <style>
      /* Generated by threads-video-studio/scripts/assemble.py - edit shots.json and re-run instead of editing here.
         Captions: rounded gothic, white with a warm brown outline and soft shadow; one highlighted word in yellow.
         Keep out of the top/bottom 15% (288px) and the right 160px (Threads UI). Green only on the final button.
         Font: Zen Maru Gothic, SIL Open Font License 1.1 (assets/fonts/OFL.txt). */
{{FONT_FACE}}
      :root { --white: #fffdf7; --edge: rgba(58, 38, 20, 0.62); --accent: #ffd76a; --cta: #06c755; --jp: "Zen Maru Gothic", "Hiragino Maru Gothic ProN", sans-serif; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: #1d1712; }
      #root { position: relative; width: 100%; height: 100%; overflow: hidden; font-family: var(--jp); color: var(--white); background: #1d1712; }
      .full { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; object-fit: cover; }
      .layer { position: absolute; inset: 0; }
      .shade { position: absolute; left: 0; right: 0; bottom: 0; height: 960px;
        background: linear-gradient(to bottom, rgba(29,23,18,0) 0%, rgba(29,23,18,0.18) 45%, rgba(29,23,18,0.42) 100%); }
      .sub { position: absolute; left: 72px; right: 160px; bottom: 340px; display: flex; flex-direction: column; align-items: center; }
      .sub .in { display: flex; flex-direction: column; align-items: center; gap: 6px; }
      .sub .l { display: block; font-weight: 900; font-size: 60px; line-height: 1.32; letter-spacing: 0.02em; text-align: center; white-space: nowrap;
        font-feature-settings: "palt" 1; -webkit-text-stroke: 12px var(--edge); paint-order: stroke fill;
        text-shadow: 0 6px 22px rgba(30, 18, 8, 0.45); }
      .em { color: var(--accent); }
      /* Ellipsis: this font draws the dots on the baseline, so lift them to the middle of the line. */
      .ell { display: inline-block; transform: translateY(-0.3em); letter-spacing: -0.04em; }
      .sub.over-cta { bottom: 640px; }
      .cta { position: absolute; left: 112px; right: 200px; top: 1330px; display: flex; flex-direction: column; align-items: center; gap: 22px; }
      .btn { width: 100%; min-height: 148px; padding: 0 28px; border-radius: 999px; background: var(--cta); display: flex; align-items: center; justify-content: center; gap: 22px;
        box-shadow: 0 14px 0 rgba(3, 110, 46, 0.55), 0 26px 50px rgba(0, 0, 0, 0.35); }
      .btn .txt { font-weight: 900; font-size: {{CTA_SIZE}}px; color: #fff; letter-spacing: 0.04em; font-feature-settings: "palt" 1; white-space: nowrap; }
      .bubble { position: relative; flex: none; width: 74px; height: 62px; border-radius: 30px; background: #fff; }
      .bubble::after { content: ""; position: absolute; left: 14px; bottom: -12px; width: 0; height: 0;
        border-left: 10px solid transparent; border-right: 14px solid transparent; border-top: 16px solid #fff; }
      .bubble .dots { position: absolute; left: 0; right: 0; top: 24px; display: flex; justify-content: center; gap: 9px; }
      .bubble .dots i { display: block; width: 11px; height: 11px; border-radius: 50%; background: var(--cta); }
      .hint { font-weight: 700; font-size: 34px; color: var(--white); letter-spacing: 0.06em; -webkit-text-stroke: 8px var(--edge); paint-order: stroke fill; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{{TOTAL}}" data-width="1080" data-height="1920">
      <!-- video: each cut plays from the start of its clip; short clips were padded with a held last frame -->
{{VIDEOS}}

      <div id="shade" class="layer clip" data-start="0" data-duration="{{TOTAL}}" data-track-index="1"><div class="shade"></div></div>

      <!-- captions -->
{{SUBS}}

{{CTA}}

      <!-- audio: one continuous narration track; BGM ducking and fades are baked into assets/bgm.wav -->
{{AUDIO}}
    </div>

    <script>
      var tl = gsap.timeline({ paused: true });
      var subs = [{{SUB_JS}}];
      subs.forEach(function (s, i) {
        var sel = s[0] + " .in";
        tl.fromTo(sel, { y: 26, opacity: 0 }, { y: 0, opacity: 1, duration: 0.28, ease: "power2.out" }, s[1]);
        tl.to(sel, { opacity: 0, duration: 0.12, ease: "power1.in" }, s[1] + s[2] - 0.12);
      });
{{CTA_JS}}
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
